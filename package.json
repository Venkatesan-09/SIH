{
  "name": "skilltwin",
  "version": "1.0.0",
  "description": "AI-Powered Competency Intelligence & Personalized Learning Platform",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm run --filter './packages/*' build && pnpm run --filter './apps/*' build",
    "test": "pnpm run --filter './apps/*' test",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:generate": "pnpm --filter api prisma generate",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "db:reset": "pnpm --filter api prisma migrate reset --force",
    "lint": "pnpm run --filter './apps/*' lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "types:build": "pnpm --filter @skilltwin/types build",
    "prepare": "pnpm --filter './packages/*' build"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
