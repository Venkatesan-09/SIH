# SkillTwin Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://skilltwin:skilltwin_dev@localhost:5432/skilltwin

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── CORS / URLs ───────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173

# ─── Feature flags ─────────────────────────────────────────────────────────────
# Options: mock | llm
AI_PROVIDER=mock

# Options: mock | real
IGOT_PROVIDER=mock

# ─── File uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=15

# ─── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── AI service (FastAPI) ──────────────────────────────────────────────────────
AI_PORT=8000

# ─── iGOT (future — stub until real credentials exist) ─────────────────────────
# IGOT_API_URL=
# IGOT_API_KEY=
